<Window x:Class="Compressr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Compressr — Video in. DVD out." Width="840" Height="1120" MinWidth="720" MinHeight="690" Background="#F3F5F8" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
  <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#F3F5F8">
  <StackPanel Margin="32">
    <DockPanel>
      <Button Content="Save screenshot" Click="SaveScreenshot" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="11"/>
      <TextBlock Text="Compressr" FontSize="34" FontWeight="Bold" Foreground="#132C40"/>
    </DockPanel>
    <TextBlock Text="Video in. DVD out." FontSize="17" Foreground="#526474" Margin="0,4,0,20"/>
    <StackPanel x:Name="Options">
      <Border BorderBrush="#8AA4BA" BorderThickness="2" CornerRadius="12" Background="White" Padding="20">
        <StackPanel>
          <TextBlock Text="Videos in. One DVD out." FontSize="20" FontWeight="SemiBold"/>
          <TextBlock Text="Drop files, browse, or paste a YouTube link. Parts play in list order." Margin="0,5,0,10"/>
          <DockPanel>
            <Button Content="Browse…" Click="Browse" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <Button Content="Add" Click="AddInput" DockPanel.Dock="Right" Margin="8,0,0,0"/>
            <TextBox x:Name="Source" FontSize="14" Padding="8" VerticalContentAlignment="Center" AutomationProperties.Name="Video file or YouTube link" TextChanged="SourceChanged"/>
          </DockPanel>
          <ListBox x:Name="Inputs" Height="94" Margin="0,8,0,0" DisplayMemberPath="Label" SelectionChanged="InputSelected" AutomationProperties.Name="Ordered videos"/>
          <WrapPanel>
            <Button Content="Move up" Click="MoveUp"/><Button Content="Move down" Click="MoveDown"/>
            <Button Content="Remove" Click="RemoveInput"/><Button Content="Check fit" Click="CheckFit"/>
          </WrapPanel>
          <TextBlock x:Name="Estimate" Text="Whole videos are joined. YouTube playback timestamps are ignored." TextWrapping="Wrap" Foreground="#526474"/>
        </StackPanel>
      </Border>
      <Grid Margin="0,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
        <Border Background="#132C40" CornerRadius="10" Height="155">
          <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="DVD orientation preview"/>
        </Border>
        <StackPanel Grid.Column="1" Margin="18,0,0,0">
          <TextBlock Text="Selected video's orientation" FontWeight="SemiBold" FontSize="14"/>
          <TextBlock Text="Metadata rotation is automatic." TextWrapping="Wrap" Margin="0,4"/>
          <Button Content="Preview / refresh" Click="ShowPreview"/>
          <Button Content="Rotate right ↻" Click="Rotate"/>
          <TextBlock x:Name="RotationLabel" Text="Extra rotation: 0°" Margin="0,8"/>
        </StackPanel>
      </Grid>
      <WrapPanel>
        <StackPanel><TextBlock Text="TV standard"/><ComboBox x:Name="Standard" SelectionChanged="SettingChanged"/></StackPanel>
        <StackPanel><TextBlock Text="Disc capacity"/><ComboBox x:Name="Capacity"/></StackPanel>
        <StackPanel><TextBlock Text="Prepare as"/><ComboBox x:Name="Output"/></StackPanel>
      </WrapPanel>
      <TextBlock Text="Only download and copy videos you own or have permission to use." Foreground="#526474" TextWrapping="Wrap" Margin="0,6"/>
    </StackPanel>
    <DockPanel Margin="0,10">
      <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" DockPanel.Dock="Right" IsEnabled="False"/>
      <Button x:Name="StartButton" Content="Prepare DVD / save ISO" Click="Start" FontSize="18" FontWeight="SemiBold" Background="#176B66" Foreground="White"/>
    </DockPanel>
    <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
      <StackPanel x:Name="BurnOptions">
        <TextBlock Text="Already prepared? Burn it later." FontSize="17" FontWeight="SemiBold"/>
        <TextBlock Text="Open the saved ISO, even in a new app run. No original videos needed." TextWrapping="Wrap" Margin="0,4"/>
        <DockPanel>
          <Button Content="Refresh drives" Click="RefreshDrives" DockPanel.Dock="Right"/>
          <ComboBox x:Name="Drives" DisplayMemberPath="Label" AutomationProperties.Name="DVD writer"/>
        </DockPanel>
        <Button Content="Burn prepared DVD…" Click="BurnPrepared"/>
      </StackPanel>
    </Border>
    <TextBlock x:Name="Stage" Text="Ready" FontSize="18" FontWeight="SemiBold"/>
    <ProgressBar x:Name="Progress" Height="8" Margin="0,10" Minimum="0" Maximum="100"/>
    <TextBox x:Name="Status" Text="Prepare and save without a disc. Insert a blank DVD whenever you are ready to burn the saved ISO." IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" VerticalScrollBarVisibility="Auto" MaxHeight="150"/>
  </StackPanel>
  </ScrollViewer>
</Window>
