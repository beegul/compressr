<Window x:Class="Compressr.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Compressr.Core;assembly=Compressr.Core"
        Title="Compressr — Video in. DVD out." Width="1024" Height="960" MinWidth="720" MinHeight="690" Background="White" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Foreground="{StaticResource Ink}"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver" Closing="OnClosing">
  <Grid Background="White">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Background="#183344" Padding="24,20">
      <DockPanel>
        <Button Content="Save screenshot" Click="SaveScreenshot" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Padding="12,7"/>
        <StackPanel>
          <TextBlock Text="Compressr" FontSize="28" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock Text="Video in. DVD out." FontSize="16" Foreground="#CBDFE8" Margin="0,4,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,24,24,16">
        <WrapPanel x:Name="Options">
          <StackPanel Width="560" Margin="0,0,24,20">
            <TextBlock Text="Your videos" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock Text="Drop files here, browse, or paste a YouTube link." Foreground="{StaticResource Muted}" Margin="0,6,0,16"/>
            <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="16">
              <StackPanel>
                <DockPanel Margin="0,0,0,12">
                  <Button Content="_Browse files…" Click="Browse" DockPanel.Dock="Right"/>
                  <TextBlock Text="Add one video or several parts" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </DockPanel>
                <Label Content="Video file or YouTube link" Target="{Binding ElementName=Source}" Padding="0" Margin="0,0,0,6"/>
                <DockPanel>
                  <Button Content="_Add" Click="AddInput" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                  <TextBox x:Name="Source" AutomationProperties.Name="Video file or YouTube link" TextChanged="SourceChanged"/>
                </DockPanel>
              </StackPanel>
            </Border>
            <TextBlock x:Name="QueueSummary" Text="Play order" FontWeight="SemiBold" Margin="0,20,0,8"/>
            <Grid>
              <ListBox x:Name="Inputs" Height="124" BorderBrush="#B6C5CE" SelectionChanged="InputSelected"
                       AutomationProperties.Name="Ordered videos" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Input}"/></DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel.Style>
                  <Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers><DataTrigger Binding="{Binding ElementName=Inputs, Path=Items.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock Text="Start with a video" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Added videos appear here, in DVD playback order." Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
              <WrapPanel.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                  <Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Padding" Value="12,7"/>
                  <Style.Triggers><DataTrigger Binding="{Binding ElementName=Inputs, Path=SelectedItem}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                </Style>
              </WrapPanel.Resources>
              <Button Content="Move up" Click="MoveUp"/><Button Content="Move down" Click="MoveDown"/><Button Content="Remove" Click="RemoveInput"/>
            </WrapPanel>
            <TextBlock Text="Whole videos are joined. YouTube playback timestamps are ignored." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
            <Grid Margin="0,20,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#183344" CornerRadius="4" Height="135">
                <Grid>
                  <TextBlock Text="Orientation preview" Foreground="#CBDFE8" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ElementName=Preview, Path=Source}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                  <Image x:Name="Preview" Stretch="Uniform" AutomationProperties.Name="DVD orientation preview"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <TextBlock Text="Selected video's orientation" FontWeight="SemiBold"/>
                <TextBlock Text="Metadata rotation is automatic." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,8"/>
                <WrapPanel><Button Content="Preview / refresh" Click="ShowPreview" Padding="10,6" Margin="0,0,8,0"/><Button Content="Rotate right ↻" Click="Rotate" Padding="10,6"/></WrapPanel>
                <TextBlock x:Name="RotationLabel" Text="Extra rotation: 0°" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
              </StackPanel>
            </Grid>
          </StackPanel>
          <StackPanel Width="344" Margin="0,0,0,20">
            <Border Background="{StaticResource Surface}" CornerRadius="6" Padding="20">
              <StackPanel>
                <TextBlock Text="Your DVD" FontSize="20" FontWeight="SemiBold"/>
                <TextBlock Text="Prepare now. Burn when you're ready." Foreground="{StaticResource Muted}" Margin="0,6,0,20"/>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel>
                    <Label Content="TV standard" Target="{Binding ElementName=Standard}" Padding="0" Margin="0,0,0,6"/>
                    <ComboBox x:Name="Standard" SelectionChanged="SettingChanged" AutomationProperties.Name="TV standard"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <Label Content="Disc capacity" Target="{Binding ElementName=Capacity}" Padding="0" Margin="0,0,0,6"/>
                    <ComboBox x:Name="Capacity" AutomationProperties.Name="Disc capacity">
                      <ComboBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock>
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="4.7 GB"/><Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Static core:DiscSize.DualLayer}"><Setter Property="Text" Value="8.5 GB"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                          </TextBlock>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </Grid>
                <Label Content="Save as" Target="{Binding ElementName=Output}" Padding="0" Margin="0,16,0,6"/>
                <ComboBox x:Name="Output" AutomationProperties.Name="Save DVD as"/>
                <Border BorderBrush="#B6C5CE" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,16,0,0">
                  <StackPanel>
                    <DockPanel><Button Content="Check _fit" Click="CheckFit" DockPanel.Dock="Right" Padding="12,7"/><TextBlock Text="Will it fit?" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                    <TextBlock x:Name="Estimate" Text="Add your videos, then check duration and disc fit." Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>
            <Expander Header="Burn a saved ISO later" Margin="0,20,0,0" IsExpanded="False">
              <StackPanel x:Name="BurnOptions" Margin="0,12,0,0">
                <TextBlock Text="Open a prepared ISO. No original videos needed." Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
                <Label Content="DVD writer" Target="{Binding ElementName=Drives}" Padding="0" Margin="0,0,0,6"/>
                <ComboBox x:Name="Drives" DisplayMemberPath="Label" AutomationProperties.Name="DVD writer"/>
                <WrapPanel Margin="0,8,0,8"><Button Content="Refresh drives" Click="RefreshDrives" Margin="0,0,8,0"/><Button Content="Check disc" Click="CheckDisc"/></WrapPanel>
                <Button Content="Burn prepared DVD…" Click="BurnPrepared"/>
              </StackPanel>
            </Expander>
            <TextBlock Text="Only download and copy videos you own or have permission to use." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,20,0,0"/>
          </StackPanel>
        </WrapPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="#B6C5CE" BorderThickness="0,1,0,0" Padding="24,16">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="228"/></Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock x:Name="Stage" Text="Ready" FontSize="16" FontWeight="SemiBold" AutomationProperties.LiveSetting="Polite"/>
          <ProgressBar x:Name="Progress" Height="6" Margin="0,8" Minimum="0" Maximum="100" Foreground="{StaticResource Accent}" AutomationProperties.Name="DVD preparation progress"/>
          <TextBox x:Name="Status" Text="Save a DVD-ready ISO or folder first. No blank disc needed." IsReadOnly="True" TextWrapping="Wrap"
                   BorderThickness="0" Padding="0" Background="Transparent" Foreground="{StaticResource Muted}" VerticalScrollBarVisibility="Auto" MaxHeight="76" AutomationProperties.Name="Operation status"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <Button x:Name="StartButton" Content="_Prepare DVD" Click="Start" Style="{StaticResource PrimaryButton}"/>
          <Button x:Name="CancelButton" Content="Cancel" Click="Cancel" IsEnabled="False" Margin="0,8,0,0" MinHeight="30" Padding="10,4"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
