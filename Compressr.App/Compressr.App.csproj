<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Compressr</AssemblyName>
    <ApplicationIcon>Assets\Compressr.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="..\Compressr.Core\Compressr.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="Assets\Compressr.ico" /></ItemGroup>
</Project>
